  (text "UNUSED GATES" (at 36.83 138.43 0)
    (effects (font (size 2.54 2.54)) (justify left bottom))
    (uuid 6dd3ea7b-39de-4b06-ade4-8728d81efbd5)
  )
  (text "* Original schematic said:\n  C1 THRU C43 .1MF\n\n  Apart from the fact that C35\n  and C37-C39 are already\n  acounted for, there is no\n  footprint on the PCB for C43.\n  It is marked as being excluded\n  from the board and BOM."
    (at 135.255 89.535 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid c0d55432-2e8f-4bcf-92ca-e46fb40cbd8a)
  )
  (text "* The original schematic shows\n  C45, polarized, 33uF, connected\n  to +8V and GND, but there is no\n  footprint on the PCB, hence it\n  is marked as excluded from board\n  and BOM."
    (at 45.085 115.57 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid d9069adf-c6d3-4183-b15d-881d591775f1)
  )

